#!/bin/sh

fail () {
    echo "${*}" >&2
    exit 1
}

tmpdir=$(mktemp -d -t healthcheck.XXXXXXXXXX) || fail "mktemp failed"
trap 'rm -rf "${tmpdir}"' 0
trap 'exit 1' HUP INT QUIT PIPE TERM

curl -s --max-time 10 -o /dev/null --fail -c "${tmpdir}/cookie" http://127.0.0.1:8080/index.csp || fail "http request failed"

test -f "${tmpdir}/cookie" || fail "no cookie"

test "$(wc -l < "${tmpdir}/cookie")" -lt 5 && fail "invalid cookie"

exit 0
